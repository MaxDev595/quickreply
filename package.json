{
  "name": "quickreply",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "QuickReply — Text Expander & Auto Text. Chrome extension, landing page and shared engine.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w @quickreply/extension",
    "build": "npm run build -w @quickreply/extension && npm run build -w @quickreply/website",
    "build:extension": "npm run build -w @quickreply/extension",
    "build:website": "npm run build -w @quickreply/website",
    "package:extension": "npm run package -w @quickreply/extension",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
