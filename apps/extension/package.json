{
  "name": "@quickreply/extension",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "tsc -p tsconfig.json && vite build && vite build --config vite.content.config.ts && node scripts/check-dist.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "icons": "node scripts/generate-icons.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "test:real": "playwright test -c playwright.real.config.ts",
    "build:testnet": "node scripts/build-testnet.mjs",
    "package:testnet": "node scripts/build-testnet.mjs && node -e \"process.env.QR_OUT_DIR='dist-testnet';process.env.QR_ZIP_SUFFIX='TESTNET-not-for-store';import('./scripts/package.mjs')\""
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@quickreply/shared": "*",
    "lucide-react": "^1.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.3.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
